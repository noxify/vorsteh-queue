    "@tailwindcss/typography": "0.5.20",
    "@types/mdx": "2.0.14",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/serve-handler": "6.1.4",
    "@vorsteh-queue/adapter-drizzle": "workspace:*",

    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-compose-refs": "1.1.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.18",
    "@radix-ui/react-id": "1.1.2",

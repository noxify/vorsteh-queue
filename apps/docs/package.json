    "multimatch": "8.0.0",
    "next": "16.2.9",
    "next-themes": "latest",
    "p-map": "7.0.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "read-pkg": "^10.0.0",
    "rehype-mdx-import-media": "1.4.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",

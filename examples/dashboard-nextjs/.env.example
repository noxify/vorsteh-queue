# ─── Queue Mode ───────────────────────────────────────────────────────────────
# "direct" (default) — reads queue.config.ts and talks to the adapter directly
# "api"              — connects to a remote GraphQL server
QUEUE_MODE=direct

# ─── Direct Mode ──────────────────────────────────────────────────────────────
# PGlite socket server started by `pnpm dev:queue` (default: 127.0.0.1:5488)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5488/postgres

# Port for the PGlite socket server (used by dev:queue)
# PGLITE_PORT=5488

# ─── API Mode ─────────────────────────────────────────────────────────────────
# QUEUE_API_URL=http://localhost:4000/graphql
# QUEUE_API_TOKEN=your-token-here

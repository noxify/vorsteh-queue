generator client {
  // Required
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // Optional
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "custom_schema"]
}

model CustomQueueJob {
  id                   String    @id @default(uuid())
  queueName            String    @map("queue_name") @db.VarChar(255)
  name                 String    @db.VarChar(255)
  payload              Json      @db.JsonB
  status               String    @db.VarChar(50)
  priority             Int
  attempts             Int       @default(0)
  maxAttempts          Int       @map("max_attempts")
  createdAt            DateTime  @default(dbgenerated("timezone('utc', now())")) @map("created_at") @db.Timestamptz(6)
  processAt            DateTime  @map("process_at") @db.Timestamptz(6)
  processedAt          DateTime? @map("processed_at") @db.Timestamptz(6)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(6)
  failedAt             DateTime? @map("failed_at") @db.Timestamptz(6)
  cancelledAt          DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason   String?   @map("cancellation_reason") @db.Text
  error                Json?     @db.JsonB
  result               Json?     @db.JsonB
  progress             Int?      @default(0)
  timeout              Int?
  cron                 String?   @db.VarChar(255)
  repeatEvery          Int?      @map("repeat_every")
  repeatLimit          Int?      @map("repeat_limit")
  repeatCount          Int?      @default(0) @map("repeat_count")
  groupKey             String?   @map("group_key") @db.VarChar(255)
  uniqueKey            String?   @map("unique_key") @db.VarChar(255)
  steps                Json?     @db.JsonB
  signals              Json?     @db.JsonB
  parentId             String?   @map("parent_id") @db.VarChar(255)
  flowId               String?   @map("flow_id") @db.VarChar(255)
  childrenCount        Int?      @default(0) @map("children_count")
  childrenCompleted    Int?      @default(0) @map("children_completed")
  failParentOnFailure  Boolean?  @default(false) @map("fail_parent_on_failure")

  @@index([queueName, status, priority, createdAt], map: "idx_custom_queue_jobs_status_priority")
  @@index([processAt], map: "idx_custom_queue_jobs_process_at")
  @@index([groupKey], map: "idx_custom_queue_jobs_group_key")
  @@index([uniqueKey], map: "idx_custom_queue_jobs_unique_key")
  @@index([parentId], map: "idx_custom_queue_jobs_parent_id")
  @@index([flowId], map: "idx_custom_queue_jobs_flow_id")
  @@map("custom_queue_jobs")
  @@schema("custom_schema")
}

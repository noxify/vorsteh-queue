  "private": true,
  "description": "Advanced Vorsteh Queue example using Drizzle ORM with postgres.js and recurring jobs",
  "type": "module",
  "scripts": {
    "dev": "pnpm with-env tsx src/index.ts",
    "db:push": "pnpm with-env drizzle-kit push",

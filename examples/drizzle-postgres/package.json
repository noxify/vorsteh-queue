  },
  "dependencies": {
    "@vorsteh-queue/adapter-drizzle": "workspace:*",
    "@vorsteh-queue/core": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}

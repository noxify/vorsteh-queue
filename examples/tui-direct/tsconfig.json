{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "customConditions": ["source"],
    "types": ["node"]
  },
  "include": ["src", "queue.config.ts"],
  "exclude": ["node_modules"]
}

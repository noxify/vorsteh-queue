{
  "name": "@vorsteh-queue/adapter-drizzle",
  "version": "0.5.1",
  "description": "Drizzle ORM adapter for Vorsteh Queue with PostgreSQL support",
  "keywords": [
    "adapter",
    "background-jobs",
    "database",
    "drizzle",
    "drizzle-orm",
    "job-queue",
    "node-postgres",
    "orm",
    "pg",
    "pglite",
    "postgres",
    "postgres-js",
    "postgresql",
    "queue",
    "sql",
    "task-queue",
    "typescript",
    "worker"
  ],
  "homepage": "https://vorsteh-queue.dev",
  "bugs": "https://github.com/noxify/vorsteh-queue/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noxify/vorsteh-queue",
    "directory": "packages/adapter-drizzle"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./postgres-adapter": {
      "types": "./dist/postgres-adapter.d.mts",
      "default": "./dist/postgres-adapter.mjs"
    },
    "./postgres-schema": {
      "types": "./dist/postgres-schema.d.mts",
      "default": "./dist/postgres-schema.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "clean:cache": "git clean -xdf .cache",
    "db:generate": "drizzle-kit generate",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vorsteh-queue/core": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@vorsteh-queue/shared-tests": "workspace:*",
    "@vorsteh-queue/tsconfig": "workspace:*",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.2"
  },
  "peerDependenciesMeta": {
    "@types/pg": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}

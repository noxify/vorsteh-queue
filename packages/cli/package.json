{
  "name": "@vorsteh-queue/cli",
  "version": "0.1.0",
  "description": "CLI tool for monitoring and managing Vorsteh Queue jobs",
  "keywords": [
    "cli",
    "job-queue",
    "management",
    "monitoring",
    "queue"
  ],
  "homepage": "https://vorsteh-queue.dev",
  "bugs": "https://github.com/noxify/vorsteh-queue/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noxify/vorsteh-queue",
    "directory": "packages/cli"
  },
  "bin": {
    "vorsteh-queue": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./src/index.ts"
    },
    "./commands-metadata": {
      "types": "./dist/commands-metadata.d.mts",
      "import": "./dist/commands-metadata.mjs",
      "default": "./src/commands-metadata.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "clean:cache": "git clean -xdf .cache",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@commander-js/extra-typings": "15.0.0",
    "@vorsteh-queue/core": "workspace:*",
    "@vorsteh-queue/server": "workspace:*",
    "c12": "^2.0.4",
    "commander": "15.0.0",
    "consola": "^3.4.0"
  },
  "devDependencies": {
    "@vorsteh-queue/tsconfig": "workspace:*",
    "tsdown": "0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "name": "@vorsteh-queue/adapter-mikroorm",
  "version": "0.1.0",
  "description": "MikroORM adapter for Vorsteh Queue with PostgreSQL support",
  "keywords": [
    "adapter",
    "background-jobs",
    "database",
    "job-queue",
    "mikroorm",
    "orm",
    "postgresql",
    "queue",
    "task-queue",
    "typescript",
    "worker"
  ],
  "homepage": "https://vorsteh-queue.dev",
  "bugs": "https://github.com/noxify/vorsteh-queue/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noxify/vorsteh-queue",
    "directory": "packages/adapter-mikroorm"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./postgres-adapter": {
      "types": "./dist/adapter.d.mts",
      "source": "./src/adapter.ts",
      "default": "./dist/adapter.mjs"
    },
    "./entity": {
      "types": "./dist/queue-entity.d.mts",
      "source": "./src/queue-entity.ts",
      "default": "./dist/queue-entity.mjs"
    }
  },
  "scripts": {
    "build": "tsdown --log-level error",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "clean:cache": "git clean -xdf .cache",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vorsteh-queue/core": "workspace:*",
    "@vorsteh-queue/query-builder": "workspace:*"
  },
  "devDependencies": {
    "@mikro-orm/core": "^6.5.0",
    "@mikro-orm/postgresql": "^6.5.0",
    "@types/node": "24.13.3",
    "@vorsteh-queue/shared-tests": "workspace:*",
    "@vorsteh-queue/tsconfig": "workspace:*",
    "postgres": "^3.4.7",
    "testcontainers": "12.0.4",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@mikro-orm/core": ">=6.0.0",
    "@mikro-orm/postgresql": ">=6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}

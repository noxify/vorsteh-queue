{
  "name": "create-vorsteh-queue",
  "version": "0.1.7",
  "description": "Create Vorsteh Queue applications with one command",
  "keywords": [
    "cli",
    "create",
    "jobs",
    "queue",
    "vorsteh-queue"
  ],
  "homepage": "https://vorsteh-queue.dev",
  "bugs": "https://github.com/noxify/vorsteh-queue/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noxify/vorsteh-queue.git",
    "directory": "packages/create-vorsteh-queue"
  },
  "bin": {
    "create-vorsteh-queue": "dist/index.mjs"
  },
  "files": [
    "dist/*"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown --log-level error",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "clean:cache": "git clean -xdf .cache",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@antfu/install-pkg": "1.1.0",
    "@clack/prompts": "1.7.0",
    "giget": "3.3.1",
    "picocolors": "1.1.1",
    "read-pkg": "10.1.0",
    "terminal-link": "5.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vorsteh-queue/tsconfig": "workspace:*",
    "tsdown": "0.22.14",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "name": "@vorsteh-queue/server",
  "version": "0.1.0",
  "description": "GraphQL server for Vorsteh Queue",
  "keywords": [
    "graphql",
    "graphql-yoga",
    "hono",
    "job-queue",
    "monitoring",
    "queue",
    "server"
  ],
  "homepage": "https://vorsteh-queue.dev",
  "bugs": "https://github.com/noxify/vorsteh-queue/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noxify/vorsteh-queue",
    "directory": "packages/server"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "clean:cache": "git clean -xdf .cache",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.0.8",
    "@pothos/core": "4.13.1",
    "@vorsteh-queue/core": "workspace:*",
    "c12": "3.3.4",
    "graphql": "16.14.2",
    "graphql-yoga": "5.21.2",
    "hono": "4.12.28"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vorsteh-queue/tsconfig": "workspace:*",
    "tsdown": "0.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=22"
  }
}

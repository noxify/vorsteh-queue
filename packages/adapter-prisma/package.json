{
  "name": "@vorsteh-queue/adapter-prisma",
  "version": "0.4.1",
  "description": "Prisma ORM adapter for Vorsteh Queue with PostgreSQL support",
  "keywords": [
    "adapter",
    "background-jobs",
    "database",
    "job-queue",
    "orm",
    "postgresql",
    "prisma",
    "prisma-client",
    "queue",
    "task-queue",
    "typescript",
    "worker"
  ],
  "homepage": "https://vorsteh-queue.dev",
  "bugs": "https://github.com/noxify/vorsteh-queue/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noxify/vorsteh-queue",
    "directory": "packages/adapter-prisma"
  },
  "files": [
    "dist",
    "types"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./postgres-adapter": {
      "types": "./dist/postgres-adapter.d.mts",
      "source": "./src/postgres-adapter.ts",
      "default": "./dist/postgres-adapter.mjs"
    }
  },
  "scripts": {
    "build": "pnpm prisma:generate && tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "clean:cache": "git clean -xdf .cache",
    "dev": "tsdown --watch",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:generate_test": "prisma generate --schema=prisma/schema.test.prisma",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vorsteh-queue/core": "workspace:*"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@prisma/internals": "7.8.0",
    "@prisma/migrate": "7.8.0",
    "@types/node": "24.13.2",
    "@vorsteh-queue/shared-tests": "workspace:*",
    "@vorsteh-queue/tsconfig": "workspace:*",
    "prisma": "7.8.0",
    "testcontainers": "12.0.4",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@prisma/client": ">=7.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}

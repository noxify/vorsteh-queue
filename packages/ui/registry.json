{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "vorsteh-queue",
  "homepage": "https://vorsteh-queue.dev",
  "items": [
    {
      "name": "queue-utils",
      "type": "registry:lib",
      "title": "Queue Utilities",
      "description": "Helper functions for vorsteh-queue UI components (formatRelativeTime, formatDuration).",
      "files": [
        {
          "path": "src/lib/queue-utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "status-badge",
      "type": "registry:component",
      "title": "Status Badge",
      "description": "Displays a colored badge indicating a job's current status (pending, processing, completed, failed, etc.).",
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "src/components/status-badge.tsx",
          "type": "registry:component"
        }
      ],
      "devDependencies": ["@vorsteh-queue/core"]
    },
    {
      "name": "job-actions",
      "type": "registry:component",
      "title": "Job Actions",
      "description": "Action buttons for job operations (cancel, retry, redrive, run now, delete) with confirmation dialogs.",
      "dependencies": ["lucide-react"],
      "registryDependencies": ["button"],
      "files": [
        {
          "path": "src/components/job-actions.tsx",
          "type": "registry:component"
        }
      ],
      "devDependencies": ["@vorsteh-queue/core"]
    },
    {
      "name": "queue-stats",
      "type": "registry:component",
      "title": "Queue Stats",
      "description": "Stat cards grid showing queue metrics (pending, processing, completed, failed, etc.).",
      "dependencies": ["lucide-react"],
      "registryDependencies": ["card", "utils"],
      "files": [
        {
          "path": "src/components/queue-stats.tsx",
          "type": "registry:component"
        }
      ],
      "devDependencies": ["@vorsteh-queue/core"]
    },
    {
      "name": "job-table",
      "type": "registry:component",
      "title": "Job Table",
      "description": "A filterable, paginated table for browsing and managing queue jobs.",
      "dependencies": ["lucide-react"],
      "registryDependencies": [
        "button",
        "noxify/vorsteh-queue/status-badge",
        "noxify/vorsteh-queue/job-actions",
        "noxify/vorsteh-queue/queue-utils"
      ],
      "files": [
        {
          "path": "src/components/job-table.tsx",
          "type": "registry:component"
        }
      ],
      "devDependencies": ["@vorsteh-queue/core"]
    },
    {
      "name": "job-detail",
      "type": "registry:component",
      "title": "Job Detail",
      "description": "Detailed view of a single job including payload, error, result, and metadata.",
      "dependencies": ["lucide-react"],
      "registryDependencies": [
        "button",
        "card",
        "noxify/vorsteh-queue/status-badge",
        "noxify/vorsteh-queue/job-actions",
        "noxify/vorsteh-queue/queue-utils"
      ],
      "files": [
        {
          "path": "src/components/job-detail.tsx",
          "type": "registry:component"
        }
      ],
      "devDependencies": ["@vorsteh-queue/core"]
    },
    {
      "name": "dlq-table",
      "type": "registry:component",
      "title": "DLQ Table",
      "description": "Dead letter queue table with redrive capabilities.",
      "dependencies": ["lucide-react"],
      "registryDependencies": ["button", "noxify/vorsteh-queue/queue-utils"],
      "files": [
        {
          "path": "src/components/dlq-table.tsx",
          "type": "registry:component"
        }
      ],
      "devDependencies": ["@vorsteh-queue/core"]
    },
    {
      "name": "flow-list",
      "type": "registry:component",
      "title": "Flow List",
      "description": "Card grid displaying flow (parent-child job tree) summaries.",
      "registryDependencies": [
        "card",
        "noxify/vorsteh-queue/status-badge",
        "noxify/vorsteh-queue/queue-utils"
      ],
      "files": [
        {
          "path": "src/components/flow-list.tsx",
          "type": "registry:component"
        }
      ],
      "devDependencies": ["@vorsteh-queue/core"]
    },
    {
      "name": "flow-graph",
      "type": "registry:component",
      "title": "Flow Graph",
      "description": "Visual flow graph using ReactFlow to display parent-child job relationships.",
      "dependencies": ["@xyflow/react"],
      "registryDependencies": ["noxify/vorsteh-queue/status-badge"],
      "files": [
        {
          "path": "src/components/flow-graph.tsx",
          "type": "registry:component"
        }
      ],
      "devDependencies": ["@vorsteh-queue/core"]
    }
  ]
}

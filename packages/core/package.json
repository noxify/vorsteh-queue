{
  "name": "@vorsteh-queue/core",
  "version": "0.5.1",
  "description": "Type-safe PostgreSQL job queue for Node.js — core engine with durable execution, flow orchestration, and scheduling",
  "keywords": [
    "agenda-alternative",
    "async",
    "background-jobs",
    "bull-alternative",
    "cron",
    "database-backed",
    "delayed-jobs",
    "event-driven",
    "job-queue",
    "priority-queue",
    "progress-tracking",
    "queue",
    "redis-alternative",
    "reliable",
    "retry",
    "scheduler",
    "task-queue",
    "timezone",
    "typescript",
    "worker"
  ],
  "homepage": "https://vorsteh-queue.dev",
  "bugs": "https://github.com/noxify/vorsteh-queue/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noxify/vorsteh-queue",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./adapters/memory": {
      "types": "./dist/adapters/memory.d.mts",
      "source": "./src/adapters/memory.ts",
      "import": "./dist/adapters/memory.mjs",
      "default": "./dist/adapters/memory.mjs"
    }
  },
  "scripts": {
    "build": "tsdown --log-level error",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "clean:cache": "git clean -xdf .cache",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@vorsteh-queue/query-builder": "workspace:*",
    "croner": "10.0.1",
    "date-fns": "4.4.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@types/node": "24.13.3",
    "@vorsteh-queue/tsconfig": "workspace:*",
    "fast-check": "^4.9.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
